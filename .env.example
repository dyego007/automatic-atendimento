# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Nicho Inicial Padrão (dentista, distribuidora, imobiliaria, etc)
DEFAULT_NICHE=dentista

# Provedor de Inteligência Artificial (Opcional - se vazio, usa o motor heurístico local)
# Opções: mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Integração WhatsApp (Evolution API, Z-API ou Meta Cloud API)
WHATSAPP_PROVIDER=simulator
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Resposta por Voz / Áudio da IA (Text-to-Speech com Voz Feminina Realista de Secretária)
# Opções de VOICE_REPLIES: audio_only (responde com áudio quando cliente mandar áudio) | always | off
VOICE_REPLIES=audio_only

# OpenAI TTS (Voz feminina 'nova' - muito humana, simpática e profissional em português)
OPENAI_TTS_VOICE=nova
OPENAI_TTS_MODEL=tts-1-hd

# ElevenLabs (Opcional - voz feminina com respiração e emoção humana)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
