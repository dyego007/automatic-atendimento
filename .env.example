# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Nicho Inicial Padrão (dentista, distribuidora, imobiliaria, etc)
DEFAULT_NICHE=dentista

# Provedor de Inteligência Artificial (Opcional - se vazio, usa o motor heurístico local)
# Opções: mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Integração WhatsApp (Evolution API, Z-API ou Meta Cloud API)
WHATSAPP_PROVIDER=simulator
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
